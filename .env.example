# ─────────────────────────────────────────────────────────────
# Agentic Wallet System — Environment Configuration
# Copy this file to .env and customize the values.
#
#   cp .env.example .env
#
# ⚠ SECURITY: Never commit .env to version control.
#   This file (.env.example) contains safe defaults only.
# ─────────────────────────────────────────────────────────────

# ── Solana ──────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
RPC_COMMITMENT=confirmed
# Mainnet is GATED: set ALLOW_MAINNET=true AND provide a private SOLANA_RPC_URL
# (e.g. Helius/QuickNode/Triton). Without BOTH, the server refuses to start on
# mainnet-beta (fail-closed — it will never silently use a public RPC for mainnet).
ALLOW_MAINNET=false

# ── Server ──────────────────────────────────────────────────
PORT=3001
WS_PORT=3002

# ── Security ────────────────────────────────────────────────
# ⚠ REQUIRED: Replace these with strong, unique values before running.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_ENCRYPTION_SECRET=replace-me-with-32-hex-chars-minimum
ADMIN_API_KEY=replace-me-with-a-strong-admin-key

# ── Key custody backend ─────────────────────────────────────
# 'local'          = AES-256-GCM on disk (devnet/development only)
# 'vault-transit'  = HashiCorp Vault transit engine (production custody)
# Selecting 'vault-transit' without VAULT_ADDR/VAULT_TOKEN refuses to start.
KEY_STORE_BACKEND=local
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY_NAME=agentic-wallet

# ── Multi-tenant SaaS ──────────────────────────────────
# Secret used to hash tenant API keys (HMAC). Must be >= 16 chars.
TENANT_SECRET=replace-me-with-a-strong-tenant-secret
# Stripe usage-based billing. Leave STRIPE_SECRET_KEY empty to run in dry-run
# mode (metering still tracked locally, no network calls to Stripe).
STRIPE_SECRET_KEY=
STRIPE_BASE_URL=
STRIPE_API_VERSION=2024-06-20

# ── CORS (comma-separated origins, leave empty for default) ─
CORS_ORIGINS=

# ── Agents ──────────────────────────────────────────────────
MAX_AGENTS=20
AGENT_LOOP_INTERVAL_MS=5000

# ── Transactions ────────────────────────────────────────────
MAX_RETRIES=3
CONFIRMATION_TIMEOUT_MS=30000

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
